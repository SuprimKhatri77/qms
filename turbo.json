{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "passThroughEnv": ["REDIS_URL"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "docs:generate": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_ENV",
        "SEED_ALLOW_REMOTE_DB",
        "SEED_PASSWORD"
      ]
    }
  }
}
