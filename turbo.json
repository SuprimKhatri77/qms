{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/turbo.json"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {},
    "api#test": {
      "env": ["REDIS_URL"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DATABASE_URL",
        "FRONTEND_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "api#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "COOKIE_DOMAIN",
        "DATABASE_URL",
        "EMAIL_FROM",
        "EMAIL_PASS",
        "EMAIL_USER",
        "FRONTEND_URL",
        "PORT",
        "REDIS_URL",
        "TRUST_PROXY_HOPS"
      ]
    },
    "docs:generate": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "NODE_ENV",
        "SEED_ALLOW_REMOTE_DB",
        "SEED_PASSWORD"
      ]
    }
  }
}
