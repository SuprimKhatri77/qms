POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
# Only needed when the web server can't reach the API at NEXT_PUBLIC_API_URL
# (e.g. in Docker, where docker-compose.dev.yml sets it to http://api:5000)
# API_INTERNAL_URL=

# Optional for local — without these, emails are skipped (signup still works)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limiting (needs Redis 7+). Inside Docker, compose overrides this to
# redis://redis:6379. If Redis is unreachable, rate limiting is skipped.
REDIS_URL=redis://localhost:6379
# How many proxies sit in front of the API, so the rate limiter sees the real
# client IP. Keep 0 locally; e.g. 1 behind a single load balancer in production.
TRUST_PROXY_HOPS=0

# Password for every account `bun run db:seed` creates (same rule as the
# login form). Only needed when seeding demo data; never set it in
# production. Note: the seed reads apps/api/.env.development (like the API),
# not this file, so pass it on the command line or put it there instead.
SEED_PASSWORD=
