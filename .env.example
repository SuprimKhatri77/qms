POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
# Only needed when the web server can't reach the API at NEXT_PUBLIC_API_URL
# (e.g. in Docker, where docker-compose.dev.yml sets it to http://api:5000)
# API_INTERNAL_URL=

# Optional for local — without these, emails are skipped (signup still works)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
